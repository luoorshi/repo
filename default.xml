<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!--
    SSH：luoorshi 名下仓库。remote name 保持 github-ssh，推送用：git push github-ssh <分支>
    fetch / pushurl 末尾不要加 /。
    repo v2.62 写 push 地址时是字符串拼接 pushurl + "/" + project name，不会去掉末尾斜杠。
    写成 ssh://git@github.com/ 会得到 ssh://git@github.com//luoorshi/u-boot，git push 失败。
    fetch 会先 rstrip("/")，所以同样带末尾斜杠时 fetch 仍然正常，只有 push 出错。
  -->
  <remote name="github-ssh"
          fetch="ssh://git@github.com"
          pushurl="ssh://git@github.com" />

  <default revision="master" remote="github-ssh" sync-j="4" lfs="true" />

  <project name="luoorshi/u-boot" path="u-boot" remote="github-ssh" revision="master" />
  <project name="luoorshi/linux" path="linux" remote="github-ssh" revision="master" />

  <!-- 与 tools 一致走 SSH，避免仅 443 不稳定时出现 GnuTLS / 连接超时 -->
  <project name="crust-firmware/crust" path="crust" remote="github-ssh" revision="master" />
  <project name="TrustedFirmware-A/trusted-firmware-a" path="arm-trusted-firmware" remote="github-ssh" revision="main" />
  <project name="luoorshi/tools" path="tools" remote="github-ssh" lfs="true" revision="main" />
  <project name="luoorshi/build-scripts" path="build-scripts" remote="github-ssh" revision="main" />
  <!--
    以下仓库尚未建立或方案未定，请勿取消注释直至 URL 可用，否则 repo sync 会失败。

    工具链 / 预编译工具等：
    
    编译脚本、打包脚本等：
    
    Ubuntu 根文件系统通常体积大、不适合直接进 Git；若日后有专用镜像仓库可改为：
    <project name="luoorshi/ubuntu-rootfs" path="ubuntu-rootfs" remote="github-ssh" revision="master" />
    否则建议在 README 约定目录 ubuntu-rootfs/，用 rsync、内网镜像或解压 tarball 填充。
  -->
</manifest>
